{
  "schemaVersion": 1,
  "version": "2026.08.07.1",
  "adapters": [
    {
      "appKey": "remote-adapter-demo",
      "displayName": "Remote Adapter Demo",
      "brandColor": "#2E8B57",
      "iconPath": "icons/remote-adapter-demo.png",
      "logPaths": ["%TEMP%\\\\TapRelayRemoteAdapterDemo\\\\events.log"],
      "processNames": ["RemoteAdapterDemo"],
      "linePattern": "task=(?<taskId>[^;]+);status=(?<status>[^;]+);message=(?<message>.*)",
      "statusMap": {
        "waiting": "waiting",
        "done": "completed",
        "error": "failed",
        "stop": "stopped"
      },
      "taskIdGroup": "taskId",
      "statusGroup": "status",
      "messageGroup": "message"
    },
    {
      "appKey": "workbuddy",
      "displayName": "WorkBuddy",
      "brandColor": "#6351F1",
      "iconPath": "icons/workbuddy.png",
      "parser": "workbuddy-acp",
      "recursive": true,
      "logPaths": ["%USERPROFILE%\\\\.workbuddy\\\\logs\\\\*.log"],
      "processNames": ["WorkBuddy.exe"]
    },
    {
      "appKey": "leigod",
      "displayName": "\u96f7\u795e\u52a0\u901f\u5668",
      "brandColor": "#FF7A00",
      "iconPath": "icons/leigod.png",
      "closeReminderEnabled": true,
      "imageNames": ["leigod.exe"],
      "installRoots": ["%PROGRAMFILES(X86)%\\\\LeiGod_Acc"],
      "lifecycleMode": "leigod-client",
      "notifyOnSessionEnding": true,
      "closeReminderTitle": "\u96f7\u795e\u52a0\u901f\u5668\u5173\u95ed\u63d0\u9192",
      "closeReminderMessage": "\u60a8\u5df2\u5173\u95ed\u96f7\u795e\u52a0\u901f\u5668\u5ba2\u6237\u7aef\uff0c\u8bf7\u524d\u5f80\u96f7\u795e\u5c0f\u7a0b\u5e8f\u786e\u8ba4\u662f\u5426\u5df2\u5173\u95ed\u52a0\u901f\u670d\u52a1\uff0c\u907f\u514d\u95f2\u7f6e\u6d88\u8017\u65f6\u957f",
      "actionUrl": "",
      "logPaths": []
    },
    {
      "appKey": "comfyui",
      "displayName": "ComfyUI",
      "brandColor": "#F2FF59",
      "iconPath": "icons/comfyui.png",
      "requiresProgramUpdate": true
    }
  ]
