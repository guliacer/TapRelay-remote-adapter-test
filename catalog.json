{
  "schemaVersion": 1,
  "version": "2026.08.04.5",
  "adapters": [
    {
      "appKey": "remote-adapter-demo",
      "displayName": "Remote Adapter Demo",
      "brandColor": "#2E8B57",
      "iconPath": "icons/remote-adapter-demo.png",
      "logPaths": ["%TEMP%\\TapRelayRemoteAdapterDemo\\events.log"],
      "linePattern": "task=(?<taskId>[^;]+);status=(?<status>[^;]+);message=(?<message>.*)",
      "statusMap": {
        "waiting": "waiting",
        "done": "completed",
        "error": "failed",
        "stop": "stopped"
      },
      "taskIdGroup": "taskId",
      "statusGroup": "status",
      "messageGroup": "message"
    },
    {
      "appKey": "workbuddy",
      "displayName": "WorkBuddy",
      "brandColor": "#6351F1",
      "iconPath": "icons/workbuddy.png",
      "parser": "workbuddy-acp",
      "recursive": true,
      "logPaths": ["%USERPROFILE%\\.workbuddy\\logs\\*.log"]
    },
    {
      "appKey": "leigod",
      "displayName": "雷神加速器",
      "brandColor": "#FF7A00",
      "iconPath": "icons/leigod.png",
      "closeReminderEnabled": true,
      "imageNames": ["leigod.exe"],
      "installRoots": ["%PROGRAMFILES(X86)%\\LeiGod_Acc"],
      "lifecycleMode": "leigod-client",
      "notifyOnSessionEnding": true,
      "closeReminderTitle": "雷神加速器关闭提醒",
      "closeReminderMessage": "您已关闭雷神加速器客户端，请前往雷神小程序确认是否已关闭加速服务，避免闲置消耗时长",
      "actionUrl": "",
      "logPaths": []
    }
  ]
}
